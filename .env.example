OPENAI_API_KEY=sk-...
PLANNER_MODEL=gpt-4o
WORKER_MODEL=gpt-4o-mini
SCORE_THRESHOLD=70
TOP_N=5
INTERVIEW_MINUTES=45
PANEL=alice,bob
ATS_DB=ats.db
RESUME_DIR=seed_resumes
CAL_DIR=calendars
JDS_DIR=jds
MAX_RETRIES=2
# Comma-separated origins allowed to call the API (prod frontend URL goes here).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Real Gmail invites (optional, redirect-only). All three set => each invite is
# mailed to NOTIFY_EMAIL with a [DEMO] subject. Mock addresses are never mailed.
# Absent => log-only mock. Create: Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_EMAIL=you@gmail.com
